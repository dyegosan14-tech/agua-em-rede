{
  "name": "@aer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API HTTP (Fastify): autenticação por sessão, organizações, usuários, auditoria e, nas próximas etapas, os demais módulos.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aer/config": "*",
    "@aer/contracts": "*",
    "@aer/database": "*",
    "@aer/domain": "*",
    "@fastify/cookie": "~11.0.2",
    "@node-rs/argon2": "^2.2.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "wkx": "^0.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3"
  }
}
