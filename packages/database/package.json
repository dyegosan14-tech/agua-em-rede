{
  "name": "@aer/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schema Drizzle (tipagem), migrations SQL explícitas, migrator, seed demonstrativo e suporte a testes.",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./test-support/index.ts"
