# Água em Rede — variáveis de ambiente.
# NÃO coloque segredos reais neste arquivo. Rode `npm run setup:env` para gerar um .env local
# com segredos aleatórios (substitui os marcadores __GENERATE_*__). Nunca versione o .env.

# --- Geral ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Origens permitidas (CORS e verificação de Origin), separadas por vírgula. Em produção: somente https.
CORS_ORIGINS=http://localhost:5173
# Ative apenas atrás de um proxy reverso confiável (necessário para IP correto no rate limit).
TRUST_PROXY=false
# Swagger UI em /api/docs. Desativado por padrão em produção.
API_DOCS_ENABLED=true

# --- PostgreSQL / PostGIS -------------------------------------------------
POSTGRES_USER=aer
POSTGRES_DB=aer
POSTGRES_PASSWORD=__GENERATE_DB_PASSWORD__
DATABASE_URL=postgresql://aer:__GENERATE_DB_PASSWORD__@localhost:5432/aer
DATABASE_POOL_MAX=10

# --- Redis / BullMQ -------------------------------------------------------
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_URL=redis://:__GENERATE_REDIS_PASSWORD__@localhost:6379
# "redis" (obrigatório em produção) ou "memory" (apenas desenvolvimento/testes, um único processo).
RATE_LIMIT_STORE=redis

# --- Sessões e autenticação ----------------------------------------------
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=120
# Segredo do HMAC dos tokens CSRF (mínimo 32 caracteres).
CSRF_SECRET=__GENERATE_SECRET__
# Argon2id (OWASP: >= 19 MiB e t >= 2). Em produção valores menores são recusados.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Tentativas de login por janela: por (IP + e-mail) e por IP.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_IP_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Armazenamento S3 compatível (MinIO local) ----------------------------
# Usado pelo docker-compose para criar o bucket privado. A aplicação passa a consumir
# estas variáveis na etapa de anexos (ordens de serviço).
MINIO_ROOT_USER=aer-minio
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_PASSWORD__
S3_BUCKET=aer-attachments

# --- Seed demonstrativo (nunca em produção) --------------------------------
# Se vazio, o seed gera senhas aleatórias e as imprime uma única vez no terminal.
SEED_PASSWORD=
